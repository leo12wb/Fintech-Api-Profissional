# ============================================================
# NexBank — Environment Variables Example
# Copy to .env and fill in real values before running.
# NEVER commit .env to git.
# ============================================================

# PostgreSQL
POSTGRES_DB=nexbank
POSTGRES_USER=nexbank_user
POSTGRES_PASSWORD=change_me_in_production

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexbank
SPRING_DATASOURCE_USERNAME=nexbank_user
SPRING_DATASOURCE_PASSWORD=change_me_in_production
JWT_SECRET_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:4200

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=nexbank_rabbit
RABBITMQ_PASSWORD=change_me_in_production

# App
APP_ENV=development
